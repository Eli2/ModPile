---
Language: Cpp
BasedOnStyle: LLVM
AlwaysBreakTemplateDeclarations: Yes

# The project predominantly uses tabs, with a visual width of four columns.
UseTab: ForIndentation
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4

BreakBeforeBraces: Attach
SpaceBeforeParens: Never
SpaceBeforeAssignmentOperators: true
SpaceAfterCStyleCast: false
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

# Existing code intentionally keeps compact guards and small functions inline.
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLambdasOnASingleLine: None
AllowShortLoopsOnASingleLine: true

# Preserve hand-grouped dependencies and avoid wrapping existing long SQL/log
# expressions solely because they cross an arbitrary width.
SortIncludes: Never
ColumnLimit: 120

# Preserve local alignment without creating broad new alignment groups.
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignAfterOpenBracket: BlockIndent
AlignOperands: DontAlign
AlignTrailingComments: true

BinPackArguments: false
BinPackParameters: false
AllowAllParametersOfDeclarationOnNextLine: false
Cpp11BracedListStyle: true
IndentCaseLabels: true
IndentPPDirectives: None
KeepEmptyLinesAtTheStartOfBlocks: true
MaxEmptyLinesToKeep: 3
NamespaceIndentation: None
LambdaBodyIndentation: OuterScope
AccessModifierOffset: -4
EmptyLineBeforeAccessModifier: Never
ReflowComments: false
...
